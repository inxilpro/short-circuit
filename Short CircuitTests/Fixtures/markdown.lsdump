localizedShortNames:        "ar" = "الملاحظات", "Base" = ?, "ca" = "Notes", "cs" = "Poznámky", "da" = "Noter", "de" = "Notizen", "el" = "Σημειώσεις", "en" = "Notes", "en_AU" = "Notes", "en_GB" = "Notes", "es" = "Notas", "es_419" = "Notas", "es_US" = "Notas", "fi" = "Muistiin­panot", "fr" = "Notes", "fr_CA" = "Notes", "he" = "פתקים", "hi" = "नोट्स", "hr" = "Bilješke", "hu" = "Jegyzetek", "id" = "Catatan", "it" = "Note", "ja" = "メモ", "ko" = "메모", "LSDefaultLocalizedValue" = "Notes", "ms" = "Nota", "nl" = "Notities", "no" = "Notater", "pl" = "Notatki", "pt_BR" = "Notas", "pt_PT" = "Notas", "ro" = "Notițe", "ru" = "Заметки", "sk" = "Poznámky", "sl" = "Zapiski", "sv" = "Anteckningar", "th" = "โน้ต", "tr" = "Notlar", "uk" = "Нотатки", "vi" = "Ghi chú", "zh_CN" = "备忘录", "zh_HK" = "備忘錄", "zh_TW" = "備忘錄"
MicUsage:                   "ar" = "سيتيح لك ذلك إضافة الصوت المسجل إلى الملاحظات.", "Base" = ?, "ca" = "Aquesta opció et permet afegir gravacions d’àudio a les notes.", "cs" = "Tato volba umožňuje přidávat do poznámek nahrané zvuky.", "da" = "Dette gør det muligt at føje optaget lyd til noter.", "de" = "Du kannst Audioaufnahmen zu Notizen hinzufügen.", "el" = "Αυτή η ρύθμιση θα σας επιτρέψει να προσθέτετε εγγεγραμένο ήχο στις σημειώσεις.", "en" = "This will let you add recorded audio to notes.", "en_AU" = "This will let you add recorded audio to notes.", "en_GB" = "This will let you add recorded audio to notes.", "es" = "Esto te permitirá añadir audio grabado a las notas.", "es_419" = "Esto te permitirá agregar audio grabado a las notas.", "es_US" = "Esto te permitirá agregar audio grabado a las notas.", "fi" = "Tämä sallii tallennetun äänen lisäämisen muistiinpanoihin.", "fr" = "Cela vous permettra d’ajouter du contenu audio enregistré aux notes.", "fr_CA" = "Cela vous permettra d’ajouter du contenu audio enregistré aux notes.", "he" = "הגדרה זו תאפשר לך להוסיף שמע מוקלט לפתקים.", "hi" = "इससे आपको रिकॉर्ड किए गए ऑडियो को नोट्स में जोड़ने की अनुमति मिल जाएगी।", "hr" = "Ova opcija omogućit će vam dodavanje snimljenog zvuka u bilješke.", "hu" = "Ezzel a funkcióval hangfelvételt adhat a jegyzetekhez.", "id" = "Ini akan memungkinkan Anda untuk menambahkan audio yang direkam ke catatan.", "it" = "L’azione ti consentirà di aggiungere audio registrato alle note.", "ja" = "録音したオーディオをメモに追加できます。", "ko" = "이렇게 하면 메모에 녹음된 오디오를 추가할 수 있습니다.", "LSDefaultLocalizedValue" = "This will let you add recorded audio to notes.", "ms" = "Ini akan membenarkan anda menambahkan audio dirakam ke nota.", "nl" = "Hiermee kun je opgenomen audio toevoegen aan notities.", "no" = "Dette gjør det mulig å legge til lydopptak i notater.", "pl" = "Pozwoli to dodawać nagrane dźwięki do notatek.", "pt_BR" = "Isso permitirá que você adicione áudio gravado às notas.", "pt_PT" = "Desta forma, poderá adicionar áudio gravado a notas.", "ro" = "Aceasta vă va permite să adăugați în notițe conținutul audio înregistrat.", "ru" = "Вы сможете добавлять аудиозаписи в заметки.", "sk" = "Umožňuje vám pridávať do poznámok nahrané audio.", "sl" = "Tako boste lahko zapiskom dodali posneti zvok.", "sv" = "Detta gör det möjligt att lägga till inspelat ljud i anteckningar.", "th" = "การทำงานนี้จะช่วยให้คุณเพิ่มเสียงบันทึกไปยังโน้ตได้", "tr" = "Bu, notlara ses kaydı eklemenizi sağlar.", "uk" = "Це дасть вам змогу додавати записані аудіофайли до нотаток.", "vi" = "Việc này sẽ cho phép bạn thêm âm thanh được ghi vào ghi chú.", "zh_CN" = "这可让你将录制的音频添加到备忘录。", "zh_HK" = "這可讓你將已錄製的音訊加至備忘錄。", "zh_TW" = "這可讓你將錄製的音訊加入備忘錄。"
